# --- Optional: photo scan (Claude Haiku, <1 cent per photo). Recipes are free via TheMealDB ---
ANTHROPIC_API_KEY=

# --- Phone alerts: install the ntfy app and subscribe to this topic ---
# Pick something unguessable; anyone who knows the topic can read it.
NTFY_TOPIC=

# --- Optional: shared secret the ESP32 pod sends (X-Pod-Key). Set the same value in the firmware.
POD_KEY=

# --- Optional: Firebase Realtime Database (leave blank to store in data.json) ---
# e.g. https://eat-me-first-default-rtdb.firebaseio.com
FIREBASE_DB_URL=
# Only needed if your database rules require auth (Database secret)
FIREBASE_DB_SECRET=

# --- Tuning (defaults match the spec; shrink for live demos) ---
PORT=3000
AVG_WINDOW_MIN=15
WARM_ALERT_MIN=60
GAS_RISE_PCT=25
GAS_ALERT_COOLDOWN_MIN=30
EXPIRY_ALERT_DAYS=2
# Multiplies how fast items age (1 = real time, 1440 = one day per minute)
DEMO_SPEED=1
